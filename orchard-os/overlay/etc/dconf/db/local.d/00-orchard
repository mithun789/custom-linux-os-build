# Orchard OS defaults for GSettings-based apps and the Plank dock.

[org/gnome/desktop/interface]
gtk-theme='WhiteSur-Light'
icon-theme='WhiteSur'
cursor-theme='WhiteSur-cursors'
cursor-size=24
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='JetBrains Mono 10'
color-scheme='prefer-light'

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'

[net/launchpad/plank/docks/dock1]
theme='Orchard'
position='bottom'
alignment='center'
icon-size=52
zoom-enabled=true
zoom-percent=145
hide-mode='intelligent'
hide-delay=300
unhide-delay=0
pressure-reveal=false
show-dock-item=false
lock-items=false
current-workspace-only=false
pinned-only=false
auto-pinning=true
dock-items=['00-install.dockitem', '01-files.dockitem', '02-launchpad.dockitem', '03-browser.dockitem', '04-terminal.dockitem', '05-code.dockitem', '06-texteditor.dockitem', '07-store.dockitem', '08-music.dockitem', '09-activity.dockitem', '10-orchard-ai.dockitem', '11-orchard-agent.dockitem', '12-settings.dockitem', '99-trash.dockitem']
