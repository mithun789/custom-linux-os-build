# Orchard OS Plank theme: frosted dock material (translucent fill, blurred
# by the compositor), rounded like the macOS Dock.
[PlankTheme]
TopRoundness=14
BottomRoundness=14
LineWidth=1
OuterStrokeColor=255;;255;;255;;70
FillStartColor=250;;251;;253;;135
FillEndColor=240;;243;;247;;135
InnerStrokeColor=255;;255;;255;;120

[PlankDockTheme]
HorizPadding=6
TopPadding=6
BottomPadding=6
ItemPadding=8
IndicatorSize=4
IconShadowSize=2
UrgentBounceHeight=1.6666666666666667
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
