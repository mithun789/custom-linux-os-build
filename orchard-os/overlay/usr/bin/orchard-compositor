#!/usr/bin/env bash
# Start the blur compositor (picom). Falls back to the xfwm4 compositor when
# picom cannot start (no OpenGL) or when "Reduce transparency" is on.
set -u
state="$HOME/.config/orchard"
mkdir -p "$state"
conf="$HOME/.config/picom/picom.conf"
[[ -f "$conf" ]] || conf=/etc/xdg/picom/orchard.conf

xfwm_comp() { xfconf-query -c xfwm4 -p /general/use_compositing --create -t bool -s "$1"; }

if [[ -f "$state/reduce-transparency" ]] || ! command -v picom >/dev/null; then
    xfwm_comp true
    exit 0
fi

# One supervisor per session: stop an older one first.
pidfile="$state/compositor.pid"
old=$(cat "$pidfile" 2>/dev/null)
if [[ -n "$old" && "$old" != "$$" ]] && kill -0 "$old" 2>/dev/null; then kill "$old" 2>/dev/null; fi
echo $$ > "$pidfile"
mine() { [[ "$(cat "$pidfile" 2>/dev/null)" == "$$" ]]; }
pkill -x picom 2>/dev/null
: > "$state/picom.log"

# Supervise picom: restart it when it exits. After 3 quick failures with the
# OpenGL backend switch to xrender (no blur); after 3 more use xfwm4's
# built-in compositor. A run longer than 2 minutes resets the counter.
backends=(glx xrender)
b=0
fails=0
while [[ $b -lt ${#backends[@]} ]]; do
    backend=${backends[$b]}
    extra=()
    [[ $backend == xrender ]] && extra=(--blur-method none)
    xfwm_comp false
    sleep 1.5
    start=$(date +%s)
    picom --config "$conf" --backend "$backend" "${extra[@]}" >/dev/null 2>>"$state/picom.log"
    rc=$?
    ran=$(( $(date +%s) - start ))
    echo "$(date -Is) picom ($backend) exited with $rc after ${ran}s" >> "$state/picom.log"
    mine || exit 0
    [[ -f "$state/reduce-transparency" ]] && break
    if [[ $ran -ge 120 ]]; then fails=0; continue; fi
    fails=$((fails + 1))
    if [[ $fails -ge 3 ]]; then b=$((b + 1)); fails=0; fi
done
# No compositor could stay up (or blur was turned off): use xfwm4's built-in one.
mine && xfwm_comp true
