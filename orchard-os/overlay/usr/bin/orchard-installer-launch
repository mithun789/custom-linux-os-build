#!/usr/bin/env bash
# Start the graphical installer with root rights from the live session.
if ! grep -q 'boot=casper' /proc/cmdline; then
    zenity --info --title="Orchard OS" --text="Orchard OS is already installed on this computer." 2>/dev/null
    exit 0
fi
if sudo -n true 2>/dev/null; then
    exec sudo -E calamares "$@"
fi
exec pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" calamares "$@"
