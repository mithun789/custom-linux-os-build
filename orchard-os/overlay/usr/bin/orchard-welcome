#!/usr/bin/env python3
"""Orchard OS Welcome: first-run hub for setup tasks."""
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, Gtk  # noqa: E402

STATE = Path.home() / ".config" / "orchard"
DONE = STATE / "welcome-done"
LIVE = "boot=casper" in Path("/proc/cmdline").read_text()

CSS = b"""
.orchard-title { font-size: 26px; font-weight: 800; }
.orchard-sub { font-size: 13px; opacity: 0.7; }
.orchard-card {
    border-radius: 14px;
    padding: 14px;
    background-color: alpha(@theme_fg_color, 0.05);
}
.orchard-card:hover { background-color: alpha(@theme_fg_color, 0.10); }
.orchard-card-title { font-weight: 700; font-size: 14px; }
.orchard-card-text { font-size: 12px; opacity: 0.7; }
.orchard-primary { padding: 10px 22px; font-weight: 700; border-radius: 10px; }
"""


def run(cmd, terminal=False):
    if terminal:
        cmd = ["xfce4-terminal", "--hold", "-x"] + cmd
    try:
        subprocess.Popen(cmd, start_new_session=True)
    except FileNotFoundError as exc:
        dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR,
                                   buttons=Gtk.ButtonsType.OK, text=str(exc))
        dialog.run()
        dialog.destroy()


class Welcome(Gtk.Window):
    def __init__(self):
        super().__init__(title="Welcome to Orchard OS")
        self.set_default_size(860, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("orchard-logo")

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin=28)
        self.add(outer)

        head = Gtk.Box(spacing=18)
        try:
            pix = Gtk.IconTheme.get_default().load_icon("orchard-logo", 84, 0)
            head.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)
        except Exception:  # icon missing during development
            pass
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER)
        t = Gtk.Label(label="Welcome to Orchard OS", xalign=0)
        t.get_style_context().add_class("orchard-title")
        s = Gtk.Label(xalign=0, wrap=True,
                      label="A calm, fast desktop built on Ubuntu 24.04 LTS. "
                            "Pick what you want to set up. You can reopen this window from the menu.")
        s.get_style_context().add_class("orchard-sub")
        titles.pack_start(t, False, False, 0)
        titles.pack_start(s, False, False, 0)
        head.pack_start(titles, True, True, 0)
        outer.pack_start(head, False, False, 0)

        if LIVE:
            install = Gtk.Button(label="Install Orchard OS")
            install.get_style_context().add_class("suggested-action")
            install.get_style_context().add_class("orchard-primary")
            install.set_halign(Gtk.Align.START)
            install.connect("clicked", lambda *_: run(["orchard-installer-launch"]))
            outer.pack_start(install, False, False, 0)

        grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3,
                           min_children_per_line=2, column_spacing=12, row_spacing=12,
                           homogeneous=True, valign=Gtk.Align.START)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.add(grid)
        outer.pack_start(scroller, True, True, 0)

        cards = [
            ("weather-clear-symbolic", "Light appearance", "Bright windows and a fresh wallpaper.",
             lambda: run(["orchard-appearance", "light"])),
            ("weather-clear-night-symbolic", "Dark appearance", "Easy on the eyes at night.",
             lambda: run(["orchard-appearance", "dark"])),
            ("system-software-install-symbolic", "Get apps", "Browse the Software store.",
             lambda: run(["gnome-software"])),
            ("application-x-addon-symbolic", "Enable Flathub", "Thousands of extra apps via Flatpak.",
             lambda: run(["pkexec", "flatpak", "remote-add", "--if-not-exists", "flathub",
                          "https://dl.flathub.org/repo/flathub.flatpakrepo"])),
            ("software-update-available-symbolic", "Update system", "Install the latest fixes.",
             lambda: run(["orchard-update"], terminal=True)),
            ("dialog-information-symbolic", "AI assistant", "Run a private AI model on this PC.",
             lambda: run(["orchard-ai", "gui"])),
            ("utilities-terminal-symbolic", "AI agent", "Let AI code, run commands and fix things.",
             lambda: run(["xfce4-terminal", "-T", "Orchard Agent", "-x", "orchard-agent"])),
            ("audio-input-microphone-symbolic", "Voice assistant", "Press Super+V and speak.",
             lambda: run(["orchard-voice", "setup-gui"])),
            ("security-high-symbolic", "Orchard Guard", "Antivirus, firewall and alerts.",
             lambda: run(["orchard-guard", "status-gui"])),
            ("document-revert-symbolic", "Restore points", "Snapshots you can roll back to.",
             lambda: run(["pkexec", "timeshift-gtk"])),
            ("video-display-symbolic", "Drivers", "NVIDIA, CUDA and other drivers.",
             lambda: run(["orchard-drivers", "--gui"])),
            ("system-search-symbolic", "Ask AI", "Press Super+A to ask a question anywhere.",
             lambda: run(["orchard-ai", "spotlight"])),
            ("view-reveal-symbolic", "Reduce transparency", "Solid menu bar, dock and menus.",
             lambda: run(["orchard-appearance", "transparency", "off"])),
            ("view-conceal-symbolic", "Blur and transparency", "Frosted glass materials (default).",
             lambda: run(["orchard-appearance", "transparency", "on"])),
            ("user-trash-full-symbolic", "Clean up", "Free disk space in one click.",
             lambda: run(["orchard-clean"], terminal=True)),
            ("preferences-desktop-symbolic", "Settings", "Displays, network, keyboard and more.",
             lambda: run(["xfce4-settings-manager"])),
            ("system-search-symbolic", "Spotlight", "Press Super+Space to search anything.",
             lambda: run(["orchard-spotlight"])),
            ("view-app-grid-symbolic", "Launchpad", "All your apps in a grid. Press F4.",
             lambda: run(["orchard-launchpad"])),
            ("utilities-system-monitor-symbolic", "Activity Monitor", "See what is using CPU and memory.",
             lambda: run(["gnome-system-monitor"])),
            ("input-keyboard-symbolic", "Keyboard shortcuts", "See and change shortcuts.",
             lambda: run(["xfce4-keyboard-settings"])),
        ]
        for icon, title, text, action in cards:
            grid.add(self._card(icon, title, text, action))

        foot = Gtk.Box(spacing=12)
        self.autostart = Gtk.CheckButton(label="Show this window at login")
        self.autostart.set_active(not DONE.exists())
        self.autostart.connect("toggled", self._toggle_autostart)
        foot.pack_start(self.autostart, False, False, 0)
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda *_: self.destroy())
        foot.pack_end(close, False, False, 0)
        outer.pack_end(foot, False, False, 0)

    def _card(self, icon, title, text, action):
        btn = Gtk.Button(relief=Gtk.ReliefStyle.NONE)
        btn.get_style_context().add_class("orchard-card")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DND)
        img.set_halign(Gtk.Align.START)
        lt = Gtk.Label(label=title, xalign=0)
        lt.get_style_context().add_class("orchard-card-title")
        lx = Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=22)
        lx.get_style_context().add_class("orchard-card-text")
        for w in (img, lt, lx):
            box.pack_start(w, False, False, 0)
        btn.add(box)
        btn.connect("clicked", lambda *_: action())
        return btn

    def _toggle_autostart(self, check):
        STATE.mkdir(parents=True, exist_ok=True)
        if check.get_active():
            DONE.unlink(missing_ok=True)
        else:
            DONE.touch()


def main():
    if "--autostart" in sys.argv and DONE.exists() and not LIVE:
        return 0
    win = Welcome()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
